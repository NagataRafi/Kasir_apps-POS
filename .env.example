# Environment variables for KASIR POS
# PORT=4100
# HOST=0.0.0.0
# DATABASE_URL=data.db
# IPAYMU_API_KEY=your_ipaymu_api_key_here
# IPAYMU_SANDBOX=true
# GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
# GOOGLE_SHEETS_SERVICE_ACCOUNT=your_service_account_json
# PIN_ADMIN=your_admin_pin
# ADMIN_PIN=your_admin_pin_scrypt_hash
# (Hash PIN menggunakan scrypt dari node:crypto, jangan simpan PIN mentah di kode atau commit)
# Set nilai ini sebelum menjalankan seed-admin.js
# DOMAIN=your_cloudflare_tunnel_domain
